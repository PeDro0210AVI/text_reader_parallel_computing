                <mxCell id="note_partition" value="① PARTICIÓN (tareas más pequeñas)&#xa;El archivo se divide en n chunks independientes y de tamaño similar; cada chunk es una tarea unitaria que puede procesarse sin esperar a las demás." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#ffffff;strokeColor=#82b366;dashed=1;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="2570" y="540" width="420" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="note_dep_fork" value="② DEPENDENCIA (orden de ejecución)&#xa;Crear los m hilos depende de tener ya los n chunks listos. El FORK (inicio del paralelo) espera a que init + chunking terminen (barra UNIÓN)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#ffffff;strokeColor=#b85450;dashed=1;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="2580" y="660" width="420" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="note_pu" value="③ ASIGNACIÓN DE UNIDADES DE PROCESAMIENTO&#xa;Cada uno de los m hilos se mapea a un núcleo/CPU distinto (Hilo i → Core i), modelo fork-join de memoria compartida." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;" parent="1" vertex="1">
